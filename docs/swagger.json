{
    "swagger": "2.0",
    "info": {
        "description": "堆栈人生博客系统 - 前台公开 API，供 Web 前端和微信小程序使用",
        "title": "堆栈人生 Frontend API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8082",
    "basePath": "/api",
    "paths": {
        "/articles": {
            "get": {
                "description": "获取已发布文章列表，支持分页和按分类/目录/标签过滤",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "文章列表",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "每页数量",
                        "name": "page_size",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "分类ID",
                        "name": "cid",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "目录ID",
                        "name": "did",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "标签ID",
                        "name": "tid",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "标题模糊搜索",
                        "name": "keyword",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.ArticleListResponse"
                        }
                    }
                }
            }
        },
        "/articles/{id}": {
            "get": {
                "description": "获取单篇文章详情，包含分类、目录和标签信息",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "文章详情",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "文章ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.ArticleDetailResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/categories": {
            "get": {
                "description": "获取所有启用的文章分类",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "分类列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.CategoryListResponse"
                        }
                    }
                }
            }
        },
        "/directories": {
            "get": {
                "description": "获取所有启用的文章目录",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "目录列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.DirectoryListResponse"
                        }
                    }
                }
            }
        },
        "/messages": {
            "get": {
                "description": "获取留言记录（分页）",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "留言列表",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "每页数量",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.MessageListResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "提交一条新留言，邮箱和内容为必填",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "提交留言",
                "parameters": [
                    {
                        "description": "留言内容 {name, email, url, content}",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.MessageListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/tags": {
            "get": {
                "description": "获取所有启用的文章标签",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "标签列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.TagListResponse"
                        }
                    }
                }
            }
        },
        "/website": {
            "get": {
                "description": "获取前端可见的网站配置信息（is_to_frontend=1 的键值对，如站点名称、CDN地址等）",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Frontend API"
                ],
                "summary": "网站设置",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/frontend.WebsiteResponse"
                        }
                    }
                }
            }
        }
    },
